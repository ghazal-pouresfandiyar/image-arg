      "source": "Script 4",
      "description": "One-hot encoded scene classification"
    },
    "climate_attributes": {
      "dimension": 14,
      "attributes": 12,
      "metadata_features": 2,
      "source": "Script 5",
      "description": "Binary climate attributes + brightness + color"
    },
    "premise_embeddings": {
      "dimension": 384,
      "model": "sentence-transformers/all-MiniLM-L6-v2",
      "source": "Script 6",
      "description": "Averaged premise embeddings"
    }
