{
  "dataset": {
    "num_images": 58,
    "total_features": 972
  },
  "modalities": {
    "clip_embeddings": {
      "dimension": 512,
      "model": "openai/clip-vit-base-patch32",
      "source": "Script 2",
      "description": "Normalized L2 image embeddings from CLIP"
    },
    "metadata_onehot": {
      "dimension": 33,
      "source": "Script 1",
      "description": "One-hot encoded categorical metadata"
    },
    "object_counts": {
      "dimension": 18,
      "classes": 18,
      "model": "yolov8l",
