  "output_files": {
    "unified_features.npz": "Concatenated tensor + image_ids",
    "metadata.json": "Hierarchical per-image metadata",
    "targets.json": "Premises and conclusions",
    "captions.json": "Image captions",
    "retrieved_facts.json": "Retrieved facts with scores",
    "dataset_info.json": "This file - dataset breakdown"
